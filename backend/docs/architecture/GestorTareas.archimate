<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="GestorTareas (AulaVirtual)" id="id-model-gestortareas" version="5.0.0">
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Administrador" id="el-admin"/>
    <element xsi:type="archimate:BusinessActor" name="Profesor" id="el-profesor"/>
    <element xsi:type="archimate:BusinessActor" name="Estudiante" id="el-estudiante"/>
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Frontend Ionic" id="el-app-frontend"/>
    <element xsi:type="archimate:ApplicationService" name="Servicio API REST" id="el-appsvc-api"/>
    <element xsi:type="archimate:ApplicationComponent" name="Capa de Rutas (routes)" id="el-app-routes"/>
    <element xsi:type="archimate:ApplicationComponent" name="Capa de Controladores (controllers)" id="el-app-controllers"/>
    <element xsi:type="archimate:ApplicationComponent" name="Capa de Servicios (services)" id="el-app-services"/>
    <element xsi:type="archimate:ApplicationComponent" name="Capa de Repositorios (repositories)" id="el-app-repos"/>
    <element xsi:type="archimate:DataObject" name="Base de datos relacional" id="el-data-db"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Autenticacion" id="el-fn-auth"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Materias e Inscripciones" id="el-fn-materias"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Tareas y Calificaciones" id="el-fn-tareas"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Archivos" id="el-fn-archivos"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Comentarios" id="el-fn-comentarios"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Anuncios" id="el-fn-anuncios"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Usuarios" id="el-fn-usuarios"/>
    <element xsi:type="archimate:ApplicationFunction" name="Funcion: Administracion" id="el-fn-admin"/>
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology">
    <element xsi:type="archimate:Device" name="Dispositivo (movil o navegador)" id="el-dispositivo"/>
    <element xsi:type="archimate:CommunicationNetwork" name="Red (HTTP/HTTPS)" id="el-red"/>
    <element xsi:type="archimate:Node" name="Contenedor: frontend-ionic" id="el-node-fe"/>
    <element xsi:type="archimate:SystemSoftware" name="Servidor Ionic (nginx)" id="el-sw-nginx"/>
    <element xsi:type="archimate:TechnologyService" name="Servicio Web Ionic" id="el-svc-web"/>
    <element xsi:type="archimate:Node" name="Contenedor: backend" id="el-node-be"/>
    <element xsi:type="archimate:SystemSoftware" name="API REST (Express)" id="el-sw-api"/>
    <element xsi:type="archimate:TechnologyInterface" name="Interfaz HTTPS :3001/api" id="el-iface-api"/>
    <element xsi:type="archimate:TechnologyService" name="Servicio API REST" id="el-svc-api"/>
    <element xsi:type="archimate:Artifact" name="Almacenamiento de archivos (uploads)" id="el-artifact-uploads"/>
    <element xsi:type="archimate:Node" name="Contenedor / instancia: base de datos" id="el-node-db"/>
    <element xsi:type="archimate:SystemSoftware" name="Motor PostgreSQL" id="el-sw-postgres"/>
    <element xsi:type="archimate:TechnologyService" name="Servicio de Base de Datos" id="el-svc-db"/>
  </folder>
  <folder name="Relations" id="id-folder-relations" type="relations">
    <element xsi:type="archimate:AssignmentRelationship" id="rel-1" source="el-admin" target="el-dispositivo"/>
